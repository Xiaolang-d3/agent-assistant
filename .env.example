# Required for chat + cloud speech-to-text
OPENAI_API_KEY=

# Optional: use a compatible gateway (DeepSeek, OpenRouter, local, ...)
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Search: ddg (free, no key) | tavily | auto
SEARCH_PROVIDER=auto
# TAVILY_API_KEY=

# Desktop / server
APP_HOST=127.0.0.1
APP_PORT=8765
